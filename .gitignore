# .gitignore: keeps secrets, raw data and generated clutter out of git.
# Why: CLAUDE.md says keys live in .env only and raw BANKING77 data stays out of git.
# .env.example is NOT ignored on purpose; it holds variable names only.

.env
data/
*.db

__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
